<%- include('../partials/header', {title: title}) %>
<%- include('../partials/navbar') %>

<% const v = (field, fallback = '-') => (emp[field] !== null && emp[field] !== undefined && emp[field] !== '') ? emp[field] : fallback %>
<% const fmt = (date) => date ? new Date(date).toLocaleDateString('id-ID', {day:'2-digit',month:'long',year:'numeric'}) : '-' %>
<% const fmtCurrency = (num) => num ? 'Rp ' + Number(num).toLocaleString('id-ID') : '-' %>

<div class="container py-4">
  <%- include('../partials/messages') %>

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-lines-fill"></i> Detail Karyawan</h4>
    <div class="d-flex gap-2">
      <a href="/employees/<%= emp.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
      <form action="/employees/<%= emp.id %>?_method=DELETE" method="POST" class="d-inline"
            onsubmit="return confirm('Yakin hapus karyawan ini?')">
        <button class="btn btn-outline-danger"><i class="bi bi-trash"></i> Hapus</button>
      </form>
      <a href="/employees" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Kembali</a>
    </div>
  </div>

  <!-- Profile Card -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
      <div class="row align-items-center">
        <div class="col-auto">
          <% if (emp.photo) { %>
          <img src="<%= emp.photo %>" class="rounded-circle border" width="100" height="100" style="object-fit:cover" alt="">
          <% } else { %>
          <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold mx-auto"
               style="width:100px;height:100px;font-size:32px">
            <%= emp.first_name.charAt(0).toUpperCase() %><%= emp.last_name.charAt(0).toUpperCase() %>
          </div>
          <% } %>
        </div>
        <div class="col">
          <h4 class="fw-bold mb-1"><%= emp.first_name %> <%= emp.last_name %></h4>
          <div class="text-muted mb-2"><%= v('position') %> &bull; <%= v('department') %></div>
          <div class="d-flex flex-wrap gap-2">
            <span class="badge fs-6 bg-<%= emp.status === 'active' ? 'success' : emp.status === 'resigned' ? 'warning' : emp.status === 'terminated' ? 'danger' : 'secondary' %>">
              <i class="bi bi-circle-fill me-1" style="font-size:8px"></i><%= emp.status %>
            </span>
            <span class="badge bg-secondary bg-opacity-75 text-dark fs-6"><%= emp.employment_status %></span>
            <span class="badge bg-light text-dark border fs-6"><%= emp.employment_type %></span>
          </div>
        </div>
        <div class="col-md-3 text-md-end mt-3 mt-md-0">
          <div class="text-muted small">ID Karyawan</div>
          <code class="fs-5 text-primary"><%= emp.employee_id %></code>
          <div class="text-muted small mt-2">Bergabung</div>
          <div class="fw-semibold"><%= fmt(emp.hire_date) %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Data Pribadi -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-primary text-white fw-semibold">
          <i class="bi bi-person"></i> Data Pribadi
        </div>
        <div class="card-body">
          <table class="table table-sm table-borderless mb-0">
            <tr><td class="text-muted w-40">Email</td><td><%= v('email') %></td></tr>
            <tr><td class="text-muted">Telepon</td><td><%= v('phone') %></td></tr>
            <tr><td class="text-muted">Tempat Lahir</td><td><%= v('birth_place') %></td></tr>
            <tr><td class="text-muted">Tanggal Lahir</td><td><%= fmt(emp.birth_date) %></td></tr>
            <tr><td class="text-muted">Jenis Kelamin</td><td><%= emp.gender === 'male' ? 'Laki-laki' : 'Perempuan' %></td></tr>
            <tr><td class="text-muted">Golongan Darah</td><td><%= v('blood_type') %></td></tr>
            <tr><td class="text-muted">Agama</td><td><%= v('religion') %></td></tr>
            <tr><td class="text-muted">Status Nikah</td><td><%= v('marital_status') %></td></tr>
            <tr><td class="text-muted">Kewarganegaraan</td><td><%= v('nationality') %></td></tr>
            <tr><td class="text-muted">NIK KTP</td><td><%= v('nik') %></td></tr>
            <tr><td class="text-muted">NPWP</td><td><%= v('npwp') %></td></tr>
          </table>
        </div>
      </div>
    </div>

    <!-- Alamat & Pekerjaan -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-info text-white fw-semibold">
          <i class="bi bi-geo-alt"></i> Alamat
        </div>
        <div class="card-body">
          <table class="table table-sm table-borderless mb-0">
            <tr><td class="text-muted w-40">Alamat</td><td><%= v('address') %></td></tr>
            <tr><td class="text-muted">Kota</td><td><%= v('city') %></td></tr>
            <tr><td class="text-muted">Provinsi</td><td><%= v('province') %></td></tr>
            <tr><td class="text-muted">Kode Pos</td><td><%= v('postal_code') %></td></tr>
          </table>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-success text-white fw-semibold">
          <i class="bi bi-briefcase"></i> Data Pekerjaan
        </div>
        <div class="card-body">
          <table class="table table-sm table-borderless mb-0">
            <tr><td class="text-muted w-40">Departemen</td><td><%= v('department') %></td></tr>
            <tr><td class="text-muted">Jabatan</td><td><%= v('position') %></td></tr>
            <tr><td class="text-muted">Status</td><td><%= v('employment_status') %></td></tr>
            <tr><td class="text-muted">Tipe Kerja</td><td><%= v('employment_type') %></td></tr>
            <tr><td class="text-muted">Tgl Bergabung</td><td><%= fmt(emp.hire_date) %></td></tr>
            <tr><td class="text-muted">Akhir Kontrak</td><td><%= fmt(emp.contract_end_date) %></td></tr>
          </table>
        </div>
      </div>
    </div>

    <!-- Keuangan & Bank -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-warning fw-semibold">
          <i class="bi bi-cash-stack"></i> Data Keuangan & Perbankan
        </div>
        <div class="card-body">
          <table class="table table-sm table-borderless mb-0">
            <tr><td class="text-muted w-40">Gaji Pokok</td><td class="fw-semibold text-success"><%= fmtCurrency(emp.salary) %></td></tr>
            <tr><td class="text-muted">Nama Bank</td><td><%= v('bank_name') %></td></tr>
            <tr><td class="text-muted">No. Rekening</td><td><%= v('bank_account') %></td></tr>
            <tr><td class="text-muted">Pemilik Rek</td><td><%= v('bank_account_holder') %></td></tr>
          </table>
        </div>
      </div>
    </div>

    <!-- Kontak Darurat & Catatan -->
    <div class="col-md-6">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-danger text-white fw-semibold">
          <i class="bi bi-telephone-fill"></i> Kontak Darurat
        </div>
        <div class="card-body">
          <table class="table table-sm table-borderless mb-0">
            <tr><td class="text-muted w-40">Nama</td><td><%= v('emergency_contact_name') %></td></tr>
            <tr><td class="text-muted">Telepon</td><td><%= v('emergency_contact_phone') %></td></tr>
            <tr><td class="text-muted">Hubungan</td><td><%= v('emergency_contact_relation') %></td></tr>
          </table>
        </div>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-header bg-secondary text-white fw-semibold">
          <i class="bi bi-sticky"></i> Catatan & Metadata
        </div>
        <div class="card-body">
          <table class="table table-sm table-borderless mb-0">
            <tr><td class="text-muted w-40">Catatan</td><td><%= v('notes') %></td></tr>
            <tr><td class="text-muted">Dibuat</td><td><small><%= fmt(emp.created_at) %></small></td></tr>
            <tr><td class="text-muted">Diperbarui</td><td><small><%= fmt(emp.updated_at) %></small></td></tr>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom actions -->
  <div class="d-flex gap-2 mt-4 mb-2">
    <a href="/employees/<%= emp.id %>/edit" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit Karyawan</a>
    <a href="/employees" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Kembali ke Daftar</a>
  </div>
</div>

<%- include('../partials/footer') %>
