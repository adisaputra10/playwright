<%- include('./partials/header', {title: 'Home'}) %>
<%- include('./partials/navbar') %>

<div class="container py-5">
  <%- include('./partials/messages') %>

  <!-- Hero -->
  <div class="p-5 mb-4 bg-primary text-white rounded-4 shadow">
    <h1 class="display-5 fw-bold"><i class="bi bi-building-fill"></i> Employee Management System</h1>
    <p class="col-md-8 fs-5 mt-2">Kelola data karyawan perusahaan Anda dengan mudah, cepat, dan terorganisir.</p>
    <div class="mt-4">
      <% if (!currentUser) { %>
      <a href="/login" class="btn btn-light btn-lg me-2"><i class="bi bi-box-arrow-in-right"></i> Login</a>
      <a href="/register" class="btn btn-outline-light btn-lg"><i class="bi bi-person-plus"></i> Daftar</a>
      <% } else { %>
      <a href="/dashboard" class="btn btn-light btn-lg"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <% } %>
    </div>
  </div>

  <!-- Stats -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card border-0 bg-primary bg-opacity-10 h-100 text-center py-4">
        <i class="bi bi-people-fill fs-1 text-primary"></i>
        <h2 class="fw-bold mt-2 text-primary"><%= empCount %></h2>
        <p class="text-muted mb-0">Karyawan Aktif</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 bg-success bg-opacity-10 h-100 text-center py-4">
        <i class="bi bi-person-check-fill fs-1 text-success"></i>
        <h2 class="fw-bold mt-2 text-success"><%= userCount %></h2>
        <p class="text-muted mb-0">Pengguna Sistem</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 bg-info bg-opacity-10 h-100 text-center py-4">
        <i class="bi bi-shield-check-fill fs-1 text-info"></i>
        <h2 class="fw-bold mt-2 text-info">24/7</h2>
        <p class="text-muted mb-0">Akses Kapan Saja</p>
      </div>
    </div>
  </div>

  <!-- Features -->
  <h4 class="fw-bold mb-4 text-center">Fitur Utama</h4>
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center py-4">
          <i class="bi bi-person-badge-fill fs-2 text-primary mb-3 d-block"></i>
          <h5 class="fw-semibold">Manajemen Karyawan</h5>
          <p class="text-muted small">Data lengkap karyawan: personal, pekerjaan, gaji, kontak darurat, dan foto.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center py-4">
          <i class="bi bi-people-fill fs-2 text-success mb-3 d-block"></i>
          <h5 class="fw-semibold">Manajemen User</h5>
          <p class="text-muted small">Kelola akun pengguna dengan role admin dan user.</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body text-center py-4">
          <i class="bi bi-bar-chart-fill fs-2 text-warning mb-3 d-block"></i>
          <h5 class="fw-semibold">Dashboard Analitik</h5>
          <p class="text-muted small">Statistik dan ringkasan data karyawan secara real-time.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
