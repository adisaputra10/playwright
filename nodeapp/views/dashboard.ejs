<%- include('./partials/header', {title: 'Dashboard'}) %>
<%- include('./partials/navbar') %>

<div class="container py-4">
  <%- include('./partials/messages') %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-speedometer2"></i> Dashboard</h4>
    <span class="text-muted small">Selamat datang, <strong><%= currentUser.name %></strong></span>
  </div>

  <!-- Summary Cards -->
  <div class="row g-4 mb-4">
    <div class="col-6 col-md-3">
      <div class="card text-white bg-primary border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <i class="bi bi-people-fill fs-2 opacity-75"></i>
          <div>
            <div class="small">Total Karyawan</div>
            <div class="fw-bold fs-4"><%= empCount %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-white bg-success border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <i class="bi bi-person-check-fill fs-2 opacity-75"></i>
          <div>
            <div class="small">Karyawan Aktif</div>
            <div class="fw-bold fs-4"><%= activeEmpCount %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-white bg-info border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <i class="bi bi-person-gear fs-2 opacity-75"></i>
          <div>
            <div class="small">Total User</div>
            <div class="fw-bold fs-4"><%= userCount %></div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card text-white bg-warning border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center gap-3">
          <i class="bi bi-building fs-2 opacity-75"></i>
          <div>
            <div class="small">Departemen</div>
            <div class="fw-bold fs-4"><%= deptStats.length %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <!-- Department Stats -->
    <div class="col-md-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-bottom fw-semibold">
          <i class="bi bi-building"></i> Top Departemen
        </div>
        <div class="card-body">
          <% if (deptStats.length > 0) { %>
            <% deptStats.forEach(d => { %>
            <div class="mb-3">
              <div class="d-flex justify-content-between small mb-1">
                <span><%= d.department %></span>
                <span class="text-muted"><%= d.count %> orang</span>
              </div>
              <div class="progress" style="height:6px">
                <div class="progress-bar bg-primary" style="width:<%= empCount > 0 ? Math.round(d.count/empCount*100) : 0 %>%"></div>
              </div>
            </div>
            <% }) %>
          <% } else { %>
          <p class="text-muted text-center py-3 mb-0"><i class="bi bi-inbox d-block fs-3 mb-1"></i>Belum ada data</p>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Recent Employees -->
    <div class="col-md-8">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
          <span class="fw-semibold"><i class="bi bi-clock-history"></i> Karyawan Terbaru</span>
          <a href="/employees/create" class="btn btn-sm btn-primary"><i class="bi bi-plus"></i> Tambah</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr><th>ID</th><th>Nama</th><th>Dept</th><th>Status</th></tr>
            </thead>
            <tbody>
              <% if (recentEmps.length > 0) { %>
                <% recentEmps.forEach(emp => { %>
                <tr>
                  <td><code class="small"><%= emp.employee_id %></code></td>
                  <td>
                    <a href="/employees/<%= emp.id %>" class="fw-semibold text-decoration-none">
                      <%= emp.first_name %> <%= emp.last_name %>
                    </a>
                    <div class="small text-muted"><%= emp.position || '' %></div>
                  </td>
                  <td><small><%= emp.department || '-' %></small></td>
                  <td>
                    <span class="badge rounded-pill bg-<%= emp.status === 'active' ? 'success' : emp.status === 'resigned' ? 'warning' : emp.status === 'terminated' ? 'danger' : 'secondary' %>">
                      <%= emp.status %>
                    </span>
                  </td>
                </tr>
                <% }) %>
              <% } else { %>
              <tr><td colspan="4" class="text-center text-muted py-4"><i class="bi bi-inbox d-block fs-3 mb-1"></i>Belum ada karyawan</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="card-footer bg-white border-top-0">
          <a href="/employees" class="btn btn-sm btn-outline-primary w-100">Lihat Semua Karyawan</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-lightning-charge"></i> Aksi Cepat</div>
    <div class="card-body d-flex flex-wrap gap-2">
      <a href="/employees/create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Tambah Karyawan</a>
      <a href="/users/create" class="btn btn-success"><i class="bi bi-person-gear"></i> Tambah User</a>
      <a href="/employees" class="btn btn-outline-primary"><i class="bi bi-people"></i> Daftar Karyawan</a>
      <a href="/users" class="btn btn-outline-success"><i class="bi bi-list-ul"></i> Daftar User</a>
    </div>
  </div>
</div>

<%- include('./partials/footer') %>
