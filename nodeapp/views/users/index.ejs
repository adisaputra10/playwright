<%- include('../partials/header', {title: 'Manajemen User'}) %>
<%- include('../partials/navbar') %>

<div class="container py-4">
  <%- include('../partials/messages') %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-gear"></i> Manajemen User</h4>
    <a href="/users/create" class="btn btn-primary"><i class="bi bi-person-plus"></i> Tambah User</a>
  </div>

  <!-- Search -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
      <form action="/users" method="GET" class="row g-2 align-items-center">
        <div class="col-md-7">
          <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="search" class="form-control" placeholder="Cari nama atau email..." value="<%= search %>">
          </div>
        </div>
        <div class="col-auto">
          <button type="submit" class="btn btn-primary">Cari</button>
          <a href="/users" class="btn btn-outline-secondary ms-1">Reset</a>
        </div>
      </form>
    </div>
  </div>

  <!-- Table -->
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-primary">
          <tr>
            <th width="40">#</th>
            <th>Nama</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Dibuat</th>
            <th width="100">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length > 0) { %>
            <% users.forEach((u, i) => { %>
            <tr>
              <td class="text-muted"><%= i + 1 %></td>
              <td>
                <i class="bi bi-person-circle text-secondary me-1"></i>
                <strong><%= u.name %></strong>
                <% if (currentUser && currentUser.id === u.id) { %>
                <span class="badge bg-warning text-dark ms-1" style="font-size:10px">Anda</span>
                <% } %>
              </td>
              <td class="text-muted small"><%= u.email %></td>
              <td>
                <span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'info' %>">
                  <%= u.role %>
                </span>
              </td>
              <td>
                <span class="badge bg-<%= u.status === 'active' ? 'success' : 'secondary' %>">
                  <%= u.status %>
                </span>
              </td>
              <td class="small text-muted"><%= new Date(u.created_at).toLocaleDateString('id-ID', {day:'2-digit',month:'short',year:'numeric'}) %></td>
              <td>
                <a href="/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-warning" title="Edit">
                  <i class="bi bi-pencil"></i>
                </a>
                <% if (!currentUser || currentUser.id !== u.id) { %>
                <form action="/users/<%= u.id %>?_method=DELETE" method="POST" class="d-inline"
                      onsubmit="return confirm('Yakin hapus user <%= u.name %>?')">
                  <button class="btn btn-sm btn-outline-danger" title="Hapus"><i class="bi bi-trash"></i></button>
                </form>
                <% } %>
              </td>
            </tr>
            <% }) %>
          <% } else { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-5">
              <i class="bi bi-inbox d-block fs-3 mb-2"></i>
              Tidak ada user ditemukan
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white text-muted small">
      Total: <strong><%= users.length %></strong> user
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
